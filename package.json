{
  "name": "pilot-module-federation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": "22.22.3",
    "pnpm": "11.14.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream --filter \"./apps/api\" --filter \"./vue/**\" dev",
    "dev:platform": "pnpm -r --parallel --stream --filter \"./apps/api\" --filter \"./vue/**\" dev",
    "dev:next": "pnpm -r --parallel --stream --filter \"./apps/api\" --filter \"./next/**\" dev",
    "dev:all": "pnpm -r --parallel --stream --filter \"./apps/api\" --filter \"./vue/**\" --filter \"./next/**\" dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "validate:css-parity": "node scripts/validate-css-parity.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.7.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
